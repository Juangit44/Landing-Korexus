<div class="absolute inset-0 overflow-hidden pointer-events-none z-0 select-none">
  <canvas aria-hidden="true" id="hero-typography-canvas" class="w-full h-full block pointer-events-none"></canvas>
</div>

<script>
  const WORD = 'KOREXUS';
  const FONT_FAMILY = "'Urbanist', -apple-system, BlinkMacSystemFont, sans-serif";
  const COLOR_PEACH = '#F3B47E';
  const COLOR_ORANGE = '#EC8C4E';
  const COLOR_DEEP_ORANGE = '#D0681C';

  let activeCleanup: (() => void) | null = null;

  function clamp(value: number, min: number, max: number): number {
    return Math.min(Math.max(value, min), max);
  }

  function initHeroTypography(): void {
    activeCleanup?.();
    activeCleanup = null;

    const canvas = document.getElementById('hero-typography-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const stageEl = canvas.parentElement;
    if (!stageEl) return;

    const heroSection = canvas.closest('section') || stageEl;
    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    let width = 300;
    let height = 64;
    let fontSize = 48;
    let lightX = 150;
    let lightY = 32;
    let targetX = 150;
    let targetY = 32;
    let hasActivePointer = false;
    let lastInteractionAt = 0;
    let lastFrameAt = performance.now();
    let rafId: number | null = null;
    let isVisible = false;
    let destroyed = false;

    const measureAndResize = (): void => {
      const rect = stageEl.getBoundingClientRect();
      width = Math.max(rect.width, 300);
      height = Math.max(rect.height, 64);

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      fontSize = Math.floor(Math.min(width * 0.16, height * 0.72, 165));
      const maxTextWidth = width * 0.88;
      ctx.font = `700 ${fontSize}px ${FONT_FAMILY}`;
      const measured = ctx.measureText(WORD).width;
      if (measured > maxTextWidth && measured > 0) {
        fontSize = Math.max(16, Math.floor(fontSize * (maxTextWidth / measured)));
      }

      if (!hasActivePointer) {
        lightX = width * 0.38;
        lightY = height * 0.36;
        targetX = lightX;
        targetY = lightY;
      } else {
        lightX = clamp(lightX, 0, width);
        lightY = clamp(lightY, height * 0.18, height * 0.82);
        targetX = clamp(targetX, 0, width);
        targetY = clamp(targetY, height * 0.18, height * 0.82);
      }
    };

    const draw = (): void => {
      ctx.clearRect(0, 0, width, height);

      const textX = width * 0.5;
      const textY = height * 0.52;

      ctx.font = `700 ${fontSize}px ${FONT_FAMILY}`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      const dx = textX - lightX;
      const dy = textY - lightY;
      const distance = Math.hypot(dx, dy) || 1;
      const maxOffset = Math.max(2, Math.min(fontSize * 0.055, 6.5));
      const offsetMagnitude = maxOffset * (0.45 + 0.55 * Math.min(distance / (width * 0.35), 1));
      const shadowOffsetX = (dx / distance) * offsetMagnitude;
      const shadowOffsetY = (dy / distance) * offsetMagnitude;

      ctx.save();
      ctx.shadowColor = 'rgba(20, 20, 20, 0.085)';
      ctx.shadowBlur = Math.max(4, fontSize * 0.08);
      ctx.shadowOffsetX = shadowOffsetX;
      ctx.shadowOffsetY = shadowOffsetY;
      ctx.fillStyle = 'rgba(20, 20, 20, 0.035)';
      ctx.fillText(WORD, textX + shadowOffsetX * 0.35, textY + shadowOffsetY * 0.35);
      ctx.restore();

      ctx.fillStyle = 'rgba(20, 20, 20, 0.055)';
      ctx.fillText(WORD, textX, textY);

      ctx.lineWidth = Math.max(1, fontSize * 0.014);
      ctx.strokeStyle = 'rgba(208, 104, 28, 0.14)';
      ctx.strokeText(WORD, textX, textY);

      const glowRadius = Math.max(width * 0.36, fontSize * 2.4);
      const fillGrad = ctx.createRadialGradient(lightX, lightY, 0, lightX, lightY, glowRadius);
      fillGrad.addColorStop(0, COLOR_PEACH);
      fillGrad.addColorStop(0.45, COLOR_ORANGE);
      fillGrad.addColorStop(0.78, COLOR_DEEP_ORANGE);
      fillGrad.addColorStop(1, 'rgba(208, 104, 28, 0)');

      ctx.save();
      ctx.globalAlpha = 0.34;
      ctx.fillStyle = fillGrad;
      ctx.fillText(WORD, textX, textY);
      ctx.restore();

      const rimGrad = ctx.createRadialGradient(lightX, lightY, 0, lightX, lightY, glowRadius * 0.9);
      rimGrad.addColorStop(0, COLOR_PEACH);
      rimGrad.addColorStop(0.5, COLOR_ORANGE);
      rimGrad.addColorStop(1, 'rgba(236, 140, 78, 0)');

      ctx.save();
      ctx.globalAlpha = 0.55;
      ctx.lineWidth = Math.max(1, fontSize * 0.015);
      ctx.strokeStyle = rimGrad;
      ctx.strokeText(WORD, textX - shadowOffsetX * 0.25, textY - shadowOffsetY * 0.25);
      ctx.restore();
    };

    const stopLoop = (): void => {
      if (rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    };

    const tick = (now: number): void => {
      if (destroyed || !isVisible || motionQuery.matches) {
        rafId = null;
        return;
      }

      const dt = Math.min(Math.max(now - lastFrameAt, 1), 64);
      lastFrameAt = now;

      if (!hasActivePointer || now - lastInteractionAt > 2500) {
        hasActivePointer = false;
        const phase = now * 0.00075;
        targetX = width * (0.5 + 0.24 * Math.sin(phase));
        targetY = height * (0.5 + 0.2 * Math.cos(phase * 1.3));
      }

      const easing = 1 - Math.exp(-dt * 0.006);
      lightX += (targetX - lightX) * easing;
      lightY += (targetY - lightY) * easing;

      draw();
      rafId = requestAnimationFrame(tick);
    };

    const startLoop = (): void => {
      if (destroyed || !isVisible || motionQuery.matches || rafId !== null) return;
      lastFrameAt = performance.now();
      rafId = requestAnimationFrame(tick);
    };

    const updatePointerTarget = (event: PointerEvent): void => {
      const canvasRect = canvas.getBoundingClientRect();
      const scaleX = canvasRect.width > 0 ? width / canvasRect.width : 1;
      const relX = (event.clientX - canvasRect.left) * scaleX;
      const relY = event.clientY - canvasRect.top;

      targetX = clamp(relX, 0, width);
      targetY = clamp(relY, height * 0.18, height * 0.82);
      lastInteractionAt = performance.now();
      hasActivePointer = true;
    };

    const onPointerLeave = (): void => {
      hasActivePointer = false;
    };

    const onResize = (): void => {
      measureAndResize();
      draw();
    };

    const onMotionChange = (): void => {
      if (motionQuery.matches) {
        stopLoop();
        draw();
      } else if (isVisible) {
        startLoop();
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry) return;
        isVisible = entry.isIntersecting;
        if (isVisible && !motionQuery.matches) {
          startLoop();
        } else {
          stopLoop();
        }
      },
      { threshold: 0.05 }
    );

    const cleanup = (): void => {
      destroyed = true;
      stopLoop();
      observer.disconnect();
      heroSection.removeEventListener('pointermove', updatePointerTarget as EventListener);
      heroSection.removeEventListener('pointerdown', updatePointerTarget as EventListener);
      heroSection.removeEventListener('pointerleave', onPointerLeave);
      window.removeEventListener('resize', onResize);
      motionQuery.removeEventListener('change', onMotionChange);
      document.removeEventListener('astro:before-swap', cleanup);
      window.removeEventListener('pagehide', cleanup);
      if (activeCleanup === cleanup) {
        activeCleanup = null;
      }
    };

    activeCleanup = cleanup;

    measureAndResize();
    draw();

    if (document.fonts?.ready) {
      document.fonts.ready
        .then(() => {
          if (!destroyed) {
            measureAndResize();
            draw();
          }
        })
        .catch(() => {});
    }

    heroSection.addEventListener('pointermove', updatePointerTarget as EventListener, { passive: true });
    heroSection.addEventListener('pointerdown', updatePointerTarget as EventListener, { passive: true });
    heroSection.addEventListener('pointerleave', onPointerLeave, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    motionQuery.addEventListener('change', onMotionChange);
    document.addEventListener('astro:before-swap', cleanup);
    window.addEventListener('pagehide', cleanup);

    observer.observe(heroSection);
  }

  initHeroTypography();
  document.addEventListener('astro:page-load', initHeroTypography);
  window.addEventListener('pageshow', (event: PageTransitionEvent) => {
    if (event.persisted) {
      initHeroTypography();
    }
  });
</script>
