---
import { useTranslations, type Lang } from '../i18n/ui';
import { Layers, Workflow, Palette } from '@lucide/astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    icon: Layers,
    titleKey: 'services.s1.title',
    descKey: 'services.s1.desc',
  },
  {
    icon: Workflow,
    titleKey: 'services.s2.title',
    descKey: 'services.s2.desc',
  },
  {
    icon: Palette,
    titleKey: 'services.s3.title',
    descKey: 'services.s3.desc',
  },
] as const;
---

<section id="servicios" class="py-20 sm:py-28 px-4 bg-[#FCFCFC] border-b border-[#242424]/10">
  <div class="max-w-5xl mx-auto">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="text-xs font-semibold uppercase tracking-widest text-[#B8500D] mb-2">
        {t('services.tag')}
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-[#141414]">
        {t('services.title')}
      </h2>
      <p class="mt-4 text-[#5A5A5A] text-base leading-relaxed">
        {t('services.subtitle')}
      </p>
    </div>

    <!-- Services Grid (3 columns) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {
        services.map((item, index) => {
          const Icon = item.icon;
          return (
            <div class="bg-white border border-[#242424]/10 rounded-2xl p-7 sm:p-8 hover:border-[#EC8C4E] hover:shadow-lg transition-all duration-300 group">
              <div class="w-12 h-12 rounded-xl bg-[#F3B47E]/30 text-[#D0681C] flex items-center justify-center mb-6 group-hover:bg-[#EC8C4E] group-hover:text-[#141414] transition-colors">
                <Icon class="w-6 h-6 stroke-[2]" />
              </div>
              <h3 class="text-xl sm:text-2xl font-semibold text-[#141414] tracking-tight group-hover:text-[#D0681C] transition-colors">
                {t(item.titleKey)}
              </h3>
              <p class="mt-3 text-sm sm:text-base text-[#5A5A5A] leading-relaxed">
                {t(item.descKey)}
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
