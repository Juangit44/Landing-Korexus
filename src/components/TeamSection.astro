---
import { useTranslations, type Lang } from '../i18n/ui';
import { ArrowUpRight } from '@lucide/astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const members = [
  {
    initials: 'team.m1.initials',
    name: 'team.m1.name',
    role: 'team.m1.role',
    bio: 'team.m1.bio',
    profileUrl: '#',
  },
  {
    initials: 'team.m2.initials',
    name: 'team.m2.name',
    role: 'team.m2.role',
    bio: 'team.m2.bio',
    profileUrl: '#',
  },
  {
    initials: 'team.m3.initials',
    name: 'team.m3.name',
    role: 'team.m3.role',
    bio: 'team.m3.bio',
    profileUrl: '#',
  },
] as const;
---

<section id="equipo" class="py-20 sm:py-28 px-4 bg-[#FCFCFC]">
  <div class="max-w-5xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <p class="text-xs font-semibold uppercase tracking-widest text-[#B8500D] mb-2">
        {t('team.tag')}
      </p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium tracking-tight text-[#141414]">
        {t('team.title')}
      </h2>
      <p class="mt-4 text-[#5A5A5A] text-base leading-relaxed">
        {t('team.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {
        members.map((m) => (
          <div class="bg-white border border-[#242424]/10 rounded-2xl p-7 text-center flex flex-col items-center hover:border-[#EC8C4E] hover:shadow-lg transition-all duration-300">
            <!-- Initials Avatar -->
            <div class="w-20 h-20 rounded-full bg-[#141414] text-[#EC8C4E] font-bold text-2xl flex items-center justify-center mb-5 border-2 border-[#EC8C4E]/40 shadow-inner">
              {t(m.initials)}
            </div>

            <h3 class="text-xl font-semibold text-[#141414]">
              {t(m.name)}
            </h3>
            <p class="text-xs font-semibold text-[#B8500D] uppercase tracking-wide mt-1 mb-3">
              {t(m.role)}
            </p>
            <p class="text-xs sm:text-sm text-[#5A5A5A] leading-relaxed mb-5">
              {t(m.bio)}
            </p>

            <a
              href={m.profileUrl}
              aria-label={lang === 'es' ? `Perfil profesional de ${t(m.name)}` : `Professional profile of ${t(m.name)}`}
              class="mt-auto inline-flex items-center gap-1 text-xs font-medium text-[#141414] hover:text-[#B8500D] transition-colors focus-visible:ring-2 focus-visible:ring-[#B8500D] rounded px-1"
            >
              <span>{lang === 'es' ? 'Perfil profesional' : 'Professional profile'}</span>
              <ArrowUpRight class="w-3.5 h-3.5" />
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
