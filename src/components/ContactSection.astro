---
import { useTranslations, type Lang } from '../i18n/ui';
import { CONTACT_CHANNELS } from '../config/contact';
import { Mail, MessageCircle, ArrowUpRight } from '@lucide/astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const formUrl = lang === 'en' ? '/en/contact' : '/contacto';
---

<section id="contacto" class="py-20 sm:py-24 px-4 bg-[#FCFCFC]">
  <div class="max-w-5xl mx-auto">
    <div class="bg-gradient-to-br from-[#141414] to-[#242424] text-[#FCFCFC] rounded-3xl p-8 sm:p-14 border border-[#4C4C4C]/40 relative overflow-hidden shadow-2xl">
      
      <!-- Subtle Decorative Peach Accent -->
      <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-[#EC8C4E]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-2xl relative z-10">
        <p class="text-xs font-semibold uppercase tracking-widest text-[#EC8C4E] mb-3">
          {t('contact.tag')}
        </p>
        <h2 class="text-3xl sm:text-5xl font-medium tracking-tight text-[#FCFCFC] leading-tight">
          {t('contact.title')}
        </h2>
        <p class="mt-4 text-[#B0B0B0] text-base sm:text-lg leading-relaxed">
          {t('contact.subtitle')}
        </p>

        <!-- CTA Buttons -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={formUrl}
            class="bg-[#EC8C4E] hover:bg-[#F3B47E] text-[#141414] font-semibold px-6 py-3.5 rounded-full inline-flex items-center gap-2 shadow-lg transition-transform active:scale-95 text-sm sm:text-base"
          >
            <span>{t('contact.btn_quote')}</span>
            <ArrowUpRight class="w-4 h-4 stroke-[2.5]" />
          </a>

          <a
            href={CONTACT_CHANNELS.whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${t('contact.btn_whatsapp')} (${CONTACT_CHANNELS.whatsappDisplay})`}
            class="bg-[#242424] hover:bg-[#333333] text-[#FCFCFC] border border-[#4C4C4C] font-medium px-5 py-3.5 rounded-full inline-flex items-center gap-2 transition active:scale-95 text-sm sm:text-base"
          >
            <MessageCircle class="w-4 h-4 text-emerald-400" />
            <span>{t('contact.btn_whatsapp')}</span>
          </a>
        </div>

        <!-- Quick Info -->
        <div class="mt-10 pt-8 border-t border-[#4C4C4C]/40 flex flex-wrap items-center gap-6 text-xs text-[#B0B0B0]">
          <a
            href={CONTACT_CHANNELS.emailHref}
            class="inline-flex items-center gap-2 hover:text-[#FCFCFC] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EC8C4E] rounded"
          >
            <Mail class="w-4 h-4 text-[#EC8C4E]" />
            <span>{CONTACT_CHANNELS.email}</span>
          </a>
          <div>
            <span>•</span>
          </div>
          <div>
            <span>{t('contact.placeholder_notice')}</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
