---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SystemsSection from '../components/SystemsSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import PurposeSection from '../components/PurposeSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import TeamSection from '../components/TeamSection.astro';
import ContactSection from '../components/ContactSection.astro';

const lang = 'es';
const title = 'Korexus — Software a medida para hacer crecer tu empresa';
const description = 'Diseñamos y construimos sistemas web a medida, automatizaciones y plataformas seguras. Trato directo con los desarrolladores.';
---

<BaseLayout title={title} description={description} lang={lang} currentPath="/">
  <Hero lang={lang} />
  <SystemsSection lang={lang} />
  <ServicesSection lang={lang} />
  <PurposeSection lang={lang} />
  <ProcessSection lang={lang} />
  <TeamSection lang={lang} />
  <ContactSection lang={lang} />
</BaseLayout>
