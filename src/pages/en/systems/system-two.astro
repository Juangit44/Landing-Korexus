---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ArrowLeft, Lock, CheckCircle, ShieldAlert } from '@lucide/astro';

const lang = 'en';
const title = 'Client Portal & Estimations Hub — Korexus Case Study';
const description = 'Secure private portal for real-time tracking, estimation requests, and client management.';
---

<BaseLayout title={title} description={description} lang={lang} currentPath="/en/systems/system-two">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Back Button -->
    <a
      href="/en/#sistemas"
      class="inline-flex items-center gap-2 text-xs font-semibold text-[#5A5A5A] hover:text-[#141414] mb-8 transition"
    >
      <ArrowLeft class="w-4 h-4" />
      <span>Back to Systems</span>
    </a>

    <!-- Header -->
    <div class="border-b border-[#242424]/10 pb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200 inline-flex items-center gap-1.5">
          <Lock class="w-3 h-3" />
          In Production • Private Enterprise
        </span>
        <span class="text-xs text-[#5A5A5A]">Non-Disclosure Agreement (NDA)</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-medium tracking-tight text-[#141414]">
        Client Portal & Estimations Hub
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#5A5A5A] leading-relaxed">
        High-security client area allowing corporate customers to generate automated price quotes and audit project milestones in real time.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <span class="inline-flex items-center gap-1.5 text-xs text-[#5A5A5A] bg-[#242424]/5 px-3.5 py-2 rounded-full border border-[#242424]/10">
          <ShieldAlert class="w-4 h-4 text-amber-600" />
          Access strictly limited to authenticated enterprise accounts
        </span>
        <a
          href="/en/contact"
          class="bg-[#EC8C4E] text-[#141414] font-semibold px-5 py-2.5 rounded-full text-sm hover:bg-[#F3B47E] transition"
        >
          Inquire about similar build
        </a>
      </div>
    </div>

    <!-- Content Sections -->
    <div class="py-10 space-y-12">
      <!-- Challenge -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-3">
          The Challenge
        </h2>
        <p class="text-[#5A5A5A] leading-relaxed">
          The client's corporate buyers relied on long email chains to check milestone statuses and waited several days for formal price estimations. The commercial team spent hours crafting individual PDF files by hand.
        </p>
      </section>

      <!-- Solution -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-4">
          Engineered by Korexus
        </h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Dynamic estimation engine:</strong> Automated calculation with instantaneous generation of digitally signed proposal documents.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Encrypted client portal with 2FA:</strong> Two-factor authentication guarding customer financial histories and invoices.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Webhook & automated event alerts:</strong> Real-time trigger notifications on budget approvals and order state shifts.
            </span>
          </li>
        </ul>
      </section>

      <!-- Security Note -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-4">
          Confidentiality & Data Protection
        </h2>
        <div class="bg-[#141414] rounded-2xl p-8 text-center text-[#FCFCFC] border border-[#242424]">
          <div class="max-w-md mx-auto space-y-3">
            <div class="w-12 h-12 rounded-xl bg-[#242424] text-[#F3B47E] flex items-center justify-center mx-auto">
              <Lock class="w-6 h-6" />
            </div>
            <p class="font-medium text-lg">Protected Private System</p>
            <p class="text-xs sm:text-sm text-[#B0B0B0] leading-relaxed">
              Under strict non-disclosure obligations, no public sandbox or live URLs are provided. All presentation captures use synthetic data.
            </p>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <div class="pt-6 border-t border-[#242424]/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-semibold text-[#141414]">Want to automate customer self-service?</h3>
          <p class="text-xs text-[#5A5A5A]">Let's discuss the ideal technical architecture for your company.</p>
        </div>
        <a
          href="/en/contact"
          class="bg-[#EC8C4E] text-[#141414] font-semibold px-6 py-2.5 rounded-full text-sm hover:bg-[#F3B47E] transition shrink-0"
        >
          Discuss Project
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
