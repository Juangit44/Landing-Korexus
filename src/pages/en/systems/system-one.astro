---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ArrowLeft, ExternalLink, CheckCircle, ShieldCheck } from '@lucide/astro';

const lang = 'en';
const title = 'Operations & Management Platform — Korexus Case Study';
const description = 'Bespoke web platform built to unify workflows, live inventory, and invoicing.';
---

<BaseLayout title={title} description={description} lang={lang} currentPath="/en/systems/system-one">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Back Button -->
    <a
      href="/en/#sistemas"
      class="inline-flex items-center gap-2 text-xs font-semibold text-[#5A5A5A] hover:text-[#141414] mb-8 transition"
    >
      <ArrowLeft class="w-4 h-4" />
      <span>Back to Systems</span>
    </a>

    <!-- Header -->
    <div class="border-b border-[#242424]/10 pb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          In Production • Public
        </span>
        <span class="text-xs text-[#5A5A5A]">Commercial sector client</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-medium tracking-tight text-[#141414]">
        Operations & Management Platform
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#5A5A5A] leading-relaxed">
        Custom web platform built to replace chaotic spreadsheets with a single, dependable operational source of truth.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#EC8C4E] hover:bg-[#F3B47E] text-[#141414] font-semibold px-5 py-2.5 rounded-full inline-flex items-center gap-2 shadow-sm text-sm transition"
        >
          <span>Live Demo</span>
          <ExternalLink class="w-4 h-4" />
        </a>
        <a
          href="/en/contact"
          class="bg-[#141414] text-[#FCFCFC] font-medium px-5 py-2.5 rounded-full text-sm hover:bg-[#242424] transition"
        >
          Request Similar System
        </a>
      </div>
    </div>

    <!-- Content Sections -->
    <div class="py-10 space-y-12">
      <!-- Problem -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-3">
          The Problem Solved
        </h2>
        <p class="text-[#5A5A5A] leading-relaxed">
          The company handled warehouse inventory, orders, and billing across fragmented Excel sheets. This created duplicate shipments, inventory mismatches, and severe delays in delivery reporting.
        </p>
      </section>

      <!-- Engineering solution -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-4">
          What Korexus Built
        </h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Real-time operational dashboard:</strong> Central tracking for all open orders, shipments, and automated payment status.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Granular role-based access:</strong> Strict permissions across sales, warehouse, and finance to avoid data leaks.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Lightning performance:</strong> Sub-400ms page response for field workers on tablets and mobile devices.
            </span>
          </li>
        </ul>
      </section>

      <!-- Privacy & Test Data -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-4">
          Screenshots & Verification
        </h2>
        <div class="bg-[#141414] rounded-2xl p-8 text-center text-[#FCFCFC] border border-[#242424]">
          <div class="max-w-md mx-auto space-y-3">
            <div class="w-12 h-12 rounded-xl bg-[#242424] text-[#EC8C4E] flex items-center justify-center mx-auto">
              <ShieldCheck class="w-6 h-6" />
            </div>
            <p class="font-medium text-lg">Controlled Test Environment</p>
            <p class="text-xs sm:text-sm text-[#B0B0B0] leading-relaxed">
              To safeguard proprietary customer records, public demo instances and captures exclusively display synthetic test data authorized by the client.
            </p>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <div class="pt-6 border-t border-[#242424]/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-semibold text-[#141414]">Ready to streamline your operational processes?</h3>
          <p class="text-xs text-[#5A5A5A]">Talk directly with the 3 engineers behind Korexus.</p>
        </div>
        <a
          href="/en/contact"
          class="bg-[#EC8C4E] text-[#141414] font-semibold px-6 py-2.5 rounded-full text-sm hover:bg-[#F3B47E] transition shrink-0"
        >
          Start a Conversation
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
