---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_CHANNELS } from '../../config/contact';
import { ArrowLeft, Shield } from '@lucide/astro';

const lang = 'en';
const title = 'Privacy Policy — Korexus';
const description = 'Privacy policy draft regarding information collected through the contact channels of Korexus.';
---

<BaseLayout title={title} description={description} lang={lang} currentPath="/en/privacy-policy">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <a
      href="/en/"
      class="inline-flex items-center gap-2 text-xs font-semibold text-[#5A5A5A] hover:text-[#141414] mb-8 transition"
    >
      <ArrowLeft class="w-4 h-4" />
      <span>Back to Home</span>
    </a>

    <div class="border-b border-[#242424]/10 pb-6 mb-8">
      <div class="w-10 h-10 rounded-xl bg-[#EC8C4E]/20 text-[#D0681C] flex items-center justify-center mb-3">
        <Shield class="w-5 h-5" />
      </div>
      <h1 class="text-3xl sm:text-4xl font-medium text-[#141414] tracking-tight">
        Privacy Policy
      </h1>
      <p class="text-xs text-[#5A5A5A] mt-2">
        Last updated: November 2026. (Preliminary draft subject to legal audit).
      </p>
    </div>

    <div class="prose prose-sm text-[#5A5A5A] space-y-6 leading-relaxed">
      <section>
        <h2 class="text-lg font-semibold text-[#141414] mb-2">1. Controller Identity</h2>
        <p>
          <strong>Korexus</strong> is the controller responsible for processing personal data provided through the contact form of this website.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-[#141414] mb-2">2. Data Collected & Purpose</h2>
        <p>
          We exclusively gather your <strong>name, email address, and project requirements</strong> strictly to evaluate project feasibility and reply to inquiries.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-[#141414] mb-2">3. Zero Third-Party Tracking & No Data Sale</h2>
        <p>
          This website <strong>does not use advertising cookies, third-party behavioral trackers, or data brokerage</strong>. Submissions are transmitted directly to our private engineering inbox without retention in web databases.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-[#141414] mb-2">4. Your Rights (GDPR / CCPA / Data Rights)</h2>
        <p>
          You may request deletion or verification of your contact correspondence at any time by emailing <a href={CONTACT_CHANNELS.emailHref} class="text-[#B8500D] underline font-medium">{CONTACT_CHANNELS.email}</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
