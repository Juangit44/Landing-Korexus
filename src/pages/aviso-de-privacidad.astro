---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_CHANNELS } from '../config/contact';
import { ArrowLeft, Shield } from '@lucide/astro';

const lang = 'es';
const title = 'Aviso de Privacidad — Korexus';
const description = 'Borrador de aviso de privacidad para el tratamiento de datos personales en el formulario de contacto de Korexus.';
---

<BaseLayout title={title} description={description} lang={lang} currentPath="/aviso-de-privacidad">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-xs font-semibold text-[#5A5A5A] hover:text-[#141414] mb-8 transition"
    >
      <ArrowLeft class="w-4 h-4" />
      <span>Volver al Inicio</span>
    </a>

    <div class="border-b border-[#242424]/10 pb-6 mb-8">
      <div class="w-10 h-10 rounded-xl bg-[#EC8C4E]/20 text-[#D0681C] flex items-center justify-center mb-3">
        <Shield class="w-5 h-5" />
      </div>
      <h1 class="text-3xl sm:text-4xl font-medium text-[#141414] tracking-tight">
        Aviso de Privacidad
      </h1>
      <p class="text-xs text-[#5A5A5A] mt-2">
        Última actualización: Noviembre 2026. (Borrador inicial sujeto a revisión legal).
      </p>
    </div>

    <div class="prose prose-sm text-[#5A5A5A] space-y-6 leading-relaxed">
      <section>
        <h2 class="text-lg font-semibold text-[#141414] mb-2">1. Responsable del tratamiento</h2>
        <p>
          <strong>Korexus</strong> es el responsable de recabar sus datos personales a través del formulario de contacto de este sitio web.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-[#141414] mb-2">2. Datos recabados y finalidad</h2>
        <p>
          Los únicos datos que solicitamos son su <strong>nombre, correo electrónico y mensaje</strong> con el único fin de atender su solicitud de cotización o información sobre nuestros servicios de desarrollo de software.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-[#141414] mb-2">3. Sin rastreo ni venta de datos</h2>
        <p>
          Este sitio <strong>no utiliza cookies de rastreo publicitario ni vende sus datos a terceros</strong>. Los mensajes son transmitidos directamente por correo a nuestro equipo técnico sin almacenarse en bases de datos públicas.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-[#141414] mb-2">4. Derechos ARCO / Derechos del titular</h2>
        <p>
          Puede solicitar en cualquier momento la eliminación o rectificación de su información enviando un correo a <a href={CONTACT_CHANNELS.emailHref} class="text-[#B8500D] underline font-medium">{CONTACT_CHANNELS.email}</a>.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
