---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, ExternalLink, CheckCircle, ShieldCheck } from '@lucide/astro';

const lang = 'es';
const title = 'Casa Rosa — Cafetería y Pastelería — Caso Korexus';
const description = 'Sitio web comercial para Casa Rosa en Vallegrande, Bolivia, con catálogo de productos estrella, pedidos por WhatsApp y panel privado autoadministrable.';
---

<BaseLayout title={title} description={description} lang={lang} currentPath="/sistemas/sistema-uno">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Back Button -->
    <a
      href="/#sistemas"
      class="inline-flex items-center gap-2 text-xs font-semibold text-[#5A5A5A] hover:text-[#141414] mb-8 transition"
    >
      <ArrowLeft class="w-4 h-4" />
      <span>Volver a Sistemas</span>
    </a>

    <!-- Header -->
    <div class="border-b border-[#242424]/10 pb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          En producción • Público (2026)
        </span>
        <span class="text-xs text-[#5A5A5A]">Vallegrande, Bolivia</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-medium tracking-tight text-[#141414]">
        Casa Rosa — Cafetería y Pastelería
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#5A5A5A] leading-relaxed">
        Sitio web comercial diseñado para presentar la historia y el catálogo de productos estrella de esta cafetería y pastelería artesanal, facilitar pedidos directos por WhatsApp y permitir la gestión autónoma del contenido desde un panel privado autoadministrable.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          href="https://casarosa.pages.dev/"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#EC8C4E] hover:bg-[#F3B47E] text-[#141414] font-semibold px-5 py-2.5 rounded-full inline-flex items-center gap-2 shadow-sm text-sm transition"
        >
          <span>Ver sistema en vivo</span>
          <ExternalLink class="w-4 h-4" />
        </a>
        <a
          href="/contacto"
          class="bg-[#141414] text-[#FCFCFC] font-medium px-5 py-2.5 rounded-full text-sm hover:bg-[#242424] transition"
        >
          Cotizar un sistema similar
        </a>
      </div>
    </div>

    <!-- Content Sections -->
    <div class="py-10 space-y-12">
      <!-- Objetivo del proyecto -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-3">
          Objetivo del proyecto
        </h2>
        <p class="text-[#5A5A5A] leading-relaxed">
          Dotar a Casa Rosa en Vallegrande, Bolivia, de una vitrina digital clara y acogedora donde sus clientes puedan conocer su propuesta artesanal, explorar los productos estrella, ubicar el local con facilidad y realizar pedidos en segundos por WhatsApp, al tiempo que el negocio administra su catálogo e información comercial de manera independiente.
        </p>
      </section>

      <!-- Qué construyó Korexus -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-4">
          Qué construyó Korexus
        </h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Catálogo de productos estrella e historia del local:</strong> Presentación editorial de su pastelería y cafetería artesanal para destacar sus especialidades y transmitir la identidad de la marca.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Botones directos a WhatsApp por producto:</strong> Cada producto integra un acceso directo hacia WhatsApp para iniciar el pedido de forma inmediata y sin pasos innecesarios.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Guía práctica para visitar en Vallegrande:</strong> Información clara sobre dirección, disponibilidad de estacionamiento, horarios de atención y mapa de ubicación.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Panel privado autoadministrable:</strong> Herramienta interna exclusiva para que el equipo de Casa Rosa actualice su catálogo, productos estrella e información del sitio de forma autónoma.
            </span>
          </li>
        </ul>
      </section>

      <!-- Vista previa en vivo -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-4">
          Vista previa en vivo
        </h2>
        <div class="bg-[#141414] rounded-2xl p-8 text-center text-[#FCFCFC] border border-[#242424]">
          <div class="max-w-lg mx-auto space-y-4">
            <div class="w-12 h-12 rounded-xl bg-[#242424] text-[#EC8C4E] flex items-center justify-center mx-auto">
              <ShieldCheck class="w-6 h-6" />
            </div>
            <p class="font-medium text-lg">Sitio público en línea y panel privado protegido</p>
            <p class="text-xs sm:text-sm text-[#B0B0B0] leading-relaxed">
              Puedes navegar la experiencia comercial pública de Casa Rosa directamente en producción. Por privacidad y seguridad operativa, su panel administrativo interno permanece restringido al personal autorizado del negocio y no se expone ninguna ruta interna.
            </p>
            <div class="pt-2">
              <a
                href="https://casarosa.pages.dev/"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-[#EC8C4E] hover:bg-[#F3B47E] text-[#141414] font-semibold px-5 py-2.5 rounded-full inline-flex items-center gap-2 text-sm transition"
              >
                <span>Abrir sitio en vivo</span>
                <ExternalLink class="w-4 h-4" />
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <div class="pt-6 border-t border-[#242424]/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-semibold text-[#141414]">¿Tu negocio necesita una web comercial autoadministrable?</h3>
          <p class="text-xs text-[#5A5A5A]">Conversa directamente con los 3 ingenieros de Korexus.</p>
        </div>
        <a
          href="/contacto"
          class="bg-[#EC8C4E] text-[#141414] font-semibold px-6 py-2.5 rounded-full text-sm hover:bg-[#F3B47E] transition shrink-0"
        >
          Iniciar conversación
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
