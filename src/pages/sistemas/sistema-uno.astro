---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ArrowLeft, ExternalLink, CheckCircle, ShieldCheck } from '@lucide/astro';

const lang = 'es';
const title = 'Sistema de Gestión y Operaciones — Caso Korexus';
const description = 'Plataforma web personalizada para centralizar flujos de trabajo, inventario y facturación.';
---

<BaseLayout title={title} description={description} lang={lang} currentPath="/sistemas/sistema-uno">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <!-- Back Button -->
    <a
      href="/#sistemas"
      class="inline-flex items-center gap-2 text-xs font-semibold text-[#5A5A5A] hover:text-[#141414] mb-8 transition"
    >
      <ArrowLeft class="w-4 h-4" />
      <span>Volver a Sistemas</span>
    </a>

    <!-- Header -->
    <div class="border-b border-[#242424]/10 pb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
          En producción • Público
        </span>
        <span class="text-xs text-[#5A5A5A]">Cliente del sector comercial</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-medium tracking-tight text-[#141414]">
        Sistema de Gestión y Operaciones
      </h1>
      <p class="mt-4 text-base sm:text-lg text-[#5A5A5A] leading-relaxed">
        Plataforma integral diseñada para reemplazar hojas de cálculo dispersas por una fuente única de verdad operativa.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-[#EC8C4E] hover:bg-[#F3B47E] text-[#141414] font-semibold px-5 py-2.5 rounded-full inline-flex items-center gap-2 shadow-sm text-sm transition"
        >
          <span>Ver sistema en vivo</span>
          <ExternalLink class="w-4 h-4" />
        </a>
        <a
          href="/contacto"
          class="bg-[#141414] text-[#FCFCFC] font-medium px-5 py-2.5 rounded-full text-sm hover:bg-[#242424] transition"
        >
          Cotizar un sistema similar
        </a>
      </div>
    </div>

    <!-- Content Sections -->
    <div class="py-10 space-y-12">
      <!-- El Problema -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-3">
          El problema que resolvía
        </h2>
        <p class="text-[#5A5A5A] leading-relaxed">
          El cliente manejaba sus pedidos, stock de almacén y cobranzas en múltiples archivos de Excel desincronizados. Esto provocaba pedidos duplicados, discrepancias en inventario y retrasos de hasta 48 horas en emitir reportes de entrega.
        </p>
      </section>

      <!-- Qué hizo Korexus -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-4">
          Qué construyó Korexus
        </h2>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Panel administrativo en tiempo real:</strong> Visualización centralizada de órdenes activas, despachos y estado de cobranza.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Sincronización multiusuario:</strong> Acceso por roles (administrador, bodega, ventas) con permisos específicos para evitar fugas de información.
            </span>
          </li>
          <li class="flex items-start gap-3">
            <CheckCircle class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-[#5A5A5A] leading-relaxed">
              <strong class="text-[#141414]">Arquitectura ligera y veloz:</strong> Tiempos de carga menores a 400ms para uso ágil en bodega desde tablets o móviles.
            </span>
          </li>
        </ul>
      </section>

      <!-- Visual Preview Placeholder -->
      <section>
        <h2 class="text-xl sm:text-2xl font-semibold text-[#141414] mb-4">
          Capturas y vista previa
        </h2>
        <div class="bg-[#141414] rounded-2xl p-8 text-center text-[#FCFCFC] border border-[#242424]">
          <div class="max-w-md mx-auto space-y-3">
            <div class="w-12 h-12 rounded-xl bg-[#242424] text-[#EC8C4E] flex items-center justify-center mx-auto">
              <ShieldCheck class="w-6 h-6" />
            </div>
            <p class="font-medium text-lg">Demostración en entorno controlado</p>
            <p class="text-xs sm:text-sm text-[#B0B0B0] leading-relaxed">
              Para proteger los datos comerciales de la empresa, las capturas definitivas y el enlace de demostración muestran datos sintéticos de prueba aprobados por el cliente.
            </p>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <div class="pt-6 border-t border-[#242424]/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="font-semibold text-[#141414]">¿Tu empresa necesita optimizar sus procesos?</h3>
          <p class="text-xs text-[#5A5A5A]">Conversa directamente con los 3 ingenieros de Korexus.</p>
        </div>
        <a
          href="/contacto"
          class="bg-[#EC8C4E] text-[#141414] font-semibold px-6 py-2.5 rounded-full text-sm hover:bg-[#F3B47E] transition shrink-0"
        >
          Iniciar conversación
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
